# Valkey Sentinel — systemd unit (statis, tanpa Jinja)
# Copy ke /etc/systemd/system/valkey-sentinel.service

[Unit]
Description=Valkey Sentinel (HA monitoring & failover)
After=network.target

[Service]
Type=notify
User=valkey
Group=valkey
ExecStart=/usr/local/bin/valkey-sentinel /etc/valkey/sentinel.conf
ExecStop=/usr/local/bin/valkey-cli -p 26379 shutdown
Restart=always
RestartSec=5
LimitNOFILE=65536
TimeoutStartSec=10
TimeoutStopSec=10

# Direktori yang dimiliki valkey user
RuntimeDirectory=valkey
LogsDirectory=valkey

# Hardening
# /etc/valkey writable: sentinel rewrite sentinel.conf sendiri saat master berubah
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/etc/valkey /var/lib/valkey /var/log/valkey /var/run/valkey

[Install]
WantedBy=multi-user.target
