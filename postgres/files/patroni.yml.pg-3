# Patroni config untuk node pg-3 — statis, tanpa jinja
scope: pg-ha
name: pg-3
namespace: /service/

log:
  level: INFO

restapi:
  listen: 0.0.0.0:8008
  connect_address: 10.192.67.184:8008

# etcd v3 (client python etcd3). Port 2379 = client.
etcd3:
  hosts: pg-1:2379,pg-2:2379,pg-3:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    # ASYNC (keputusan 2026-09): RPO > 0 — primary TIDAK nunggu standby,
    # performa maksimal, resiko hilang data beberapa detik terakhir saat
    # failover. Model master-slave: 1 primary (write), replica read-only.
    # Traffic aplikasi HANYA ke primary (routing via Patroni REST API :8008).
    synchronous_mode: false
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_log_hints: "on"     # wajib buat pg_rewind
        synchronous_commit: "on"

  initdb:
    - encoding: UTF8
    - data-checksums        # deteksi korupsi blok; modal buat pg_rewind/verifikasi

  pg_hba:
    - local all postgres peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all ::1/128 scram-sha-256
    - host all all 10.192.0.0/16 scram-sha-256
    - host replication replicator 10.192.0.0/16 scram-sha-256

postgresql:
  listen: 0.0.0.0:5432
  connect_address: 10.192.67.184:5432
  data_dir: /var/lib/postgresql/17/main
  bin_dir: /usr/lib/postgresql/17/bin
  pgpass: /tmp/pgpass0
  authentication:
    replication:
      username: replicator
      password: devel0pment
    superuser:
      username: postgres
      password: devel0pment
    rewind:
      username: rewind_user
      password: devel0pment
  parameters:
    unix_socket_directories: '/var/run/postgresql'
    listen_addresses: '*'
  pg_hba:
    - local all postgres peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all ::1/128 scram-sha-256
    - host all all 10.192.0.0/16 scram-sha-256
    - host replication replicator 10.192.0.0/16 scram-sha-256

watchdog:
  mode: off
