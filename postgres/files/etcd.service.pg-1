[Unit]
Description=etcd key-value store (DCS untuk PostgreSQL HA / Patroni)
Documentation=https://etcd.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd
ExecStart=/usr/local/bin/etcd \
  --name=pg-1 \
  --data-dir=/var/lib/etcd \
  --listen-peer-urls=http://10.192.66.195:2380 \
  --initial-advertise-peer-urls=http://10.192.66.195:2380 \
  --listen-client-urls=http://10.192.66.195:2379,http://127.0.0.1:2379 \
  --advertise-client-urls=http://10.192.66.195:2379 \
  --initial-cluster=pg-1=http://10.192.66.195:2380,pg-2=http://10.192.67.27:2380,pg-3=http://10.192.67.133:2380 \
  --initial-cluster-state=new \
  --initial-cluster-token=pg-ha-etcd-cluster \
  --auto-compaction-mode=periodic \
  --auto-compaction-retention=1h \
  --log-level=info
Restart=always
RestartSec=5s
LimitNOFILE=40000
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
