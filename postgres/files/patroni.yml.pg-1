# Patroni config untuk node pg-1 — statis, tanpa jinja
scope: pg-ha
name: pg-1
namespace: /service/

log:
  level: INFO

restapi:
  listen: 0.0.0.0:8008
  connect_address: 192.168.1.50:8008

# etcd v3 (client python etcd3). Port 2379 = client.
etcd3:
  hosts: pg-1:2379,pg-2:2379,pg-3:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    # RPO=0: 1 sync standby (Patroni atur synchronous_standby_names dinamis).
    # strict=false -> standby sync mati, primary tetap terima write (lab).
    synchronous_mode: true
    synchronous_node_count: 1
    synchronous_mode_strict: false
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10
        wal_log_hints: "on"     # wajib buat pg_rewind
        synchronous_commit: "on"

  initdb:
    - encoding: UTF8
    - data-checksums        # deteksi korupsi blok; modal buat pg_rewind/verifikasi

  pg_hba:
    - local all postgres peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all ::1/128 scram-sha-256
    - host all all 192.168.1.0/24 scram-sha-256
    - host replication replicator 192.168.1.0/24 scram-sha-256

postgresql:
  listen: 0.0.0.0:5432
  connect_address: 192.168.1.50:5432
  data_dir: /var/lib/postgresql/17/main
  bin_dir: /usr/lib/postgresql/17/bin
  pgpass: /tmp/pgpass0
  authentication:
    replication:
      username: replicator
      password: kodok
    superuser:
      username: postgres
      password: kodok
    rewind:
      username: rewind_user
      password: kodok
  parameters:
    unix_socket_directories: '/var/run/postgresql'
    listen_addresses: '*'
  pg_hba:
    - local all postgres peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host all all ::1/128 scram-sha-256
    - host all all 192.168.1.0/24 scram-sha-256
    - host replication replicator 192.168.1.0/24 scram-sha-256

watchdog:
  mode: off
